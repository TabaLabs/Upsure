{
  "name": "upsure-monorepo",
  "private": true,
  "description": "Easy, reliable file uploads that resume after a disconnect.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter upsure-example-react-node test:e2e",
    "example": "pnpm build && pnpm --filter upsure-example-react-node dev"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsup": "^8.5.1",
    "typescript": "~5.9.0",
    "vitest": "^4.1.11"
  }
}
