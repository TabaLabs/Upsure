{
  "name": "@tabalabs/upsure",
  "version": "0.1.1",
  "description": "Resumable file uploads for the browser: pause, resume and retry, continuing where the upload stopped. Framework-free client for the tus protocol.",
  "keywords": [
    "upload",
    "file-upload",
    "resumable",
    "resumable-upload",
    "tus",
    "chunked-upload",
    "uploader",
    "typescript"
  ],
  "license": "MIT",
  "author": "TabaLabs",
  "homepage": "https://github.com/TabaLabs/upsure/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/TabaLabs/upsure/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TabaLabs/upsure.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@tabalabs/upsure-node": "workspace:*",
    "@types/node": "^20.19.43",
    "jsdom": "^29.1.1"
  }
}
