{
  "name": "@tabalabs/upsure-node",
  "version": "0.0.0",
  "description": "Node server for Upsure resumable uploads (tus).",
  "license": "MIT",
  "author": "TabaLabs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TabaLabs/upsure.git",
    "directory": "packages/node"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5"
  },
  "devDependencies": {
    "tus-js-client": "^4.3.1"
  }
}
