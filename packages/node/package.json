{
  "name": "@tabalabs/upsure-node",
  "version": "0.1.0",
  "description": "Node server for resumable file uploads over the tus protocol, with size and type limits, content checks and auth. Works with http and Express.",
  "keywords": [
    "upload",
    "file-upload",
    "resumable",
    "resumable-upload",
    "tus",
    "tus-server",
    "node",
    "express",
    "server"
  ],
  "license": "MIT",
  "author": "TabaLabs",
  "homepage": "https://github.com/TabaLabs/upsure/tree/main/packages/node#readme",
  "bugs": {
    "url": "https://github.com/TabaLabs/upsure/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TabaLabs/upsure.git",
    "directory": "packages/node"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack ."
  },
  "dependencies": {
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.3.0",
    "tus-js-client": "^4.3.1"
  }
}
