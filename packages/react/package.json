{
  "name": "@tabalabs/upsure-react",
  "version": "0.1.0",
  "description": "React hook and drop-in component for resumable file uploads that continue where they stopped. Accessible, themeable, built on the tus protocol.",
  "keywords": [
    "react",
    "upload",
    "file-upload",
    "resumable",
    "resumable-upload",
    "tus",
    "dropzone",
    "drag-and-drop",
    "react-hook",
    "react-component"
  ],
  "license": "MIT",
  "author": "TabaLabs",
  "homepage": "https://github.com/TabaLabs/upsure/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/TabaLabs/upsure/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TabaLabs/upsure.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --strict && attw --pack . --exclude-entrypoints styles.css"
  },
  "dependencies": {
    "@tabalabs/upsure": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
